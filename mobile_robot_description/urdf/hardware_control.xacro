<?xml version="1.0"?>
<!-- ros2_control for the REAL robot (or the mock for tests without any robot or simulator).
     Same joints and interfaces as gazebo_control.xacro, so the same controllers (config/my_controllers.yaml) work.

     hw_plugin  mock_components/GenericSystem          -> no hardware: commanded wheel speeds are integrated (testing, CI)
                <your package>/<YourSystemInterface>  -> your motor driver, e.g. an Arduino / ESP32 / ODrive / CAN driver
     The extra <param> lines below are the ones the popular serial diff-drive drivers read (names differ per driver:
     check your driver's README and edit this block; unknown params are ignored). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="hw_plugin" default="mock_components/GenericSystem"/>
    <xacro:arg name="hw_device" default="/dev/ttyUSB0"/>
    <xacro:arg name="hw_baud" default="57600"/>
    <xacro:arg name="hw_counts_per_rev" default="3436"/>
    <xacro:property name="hw_plugin" value="$(arg hw_plugin)"/>

    <ros2_control name="RobotSystem" type="system">
        <hardware>
            <plugin>$(arg hw_plugin)</plugin>
            <xacro:if value="${hw_plugin.startswith('mock')}">
                <param name="calculate_dynamics">true</param>
            </xacro:if>
            <xacro:unless value="${hw_plugin.startswith('mock')}">
                <param name="left_wheel_name">left_wheel_joint</param>
                <param name="right_wheel_name">right_wheel_joint</param>
                <param name="device">$(arg hw_device)</param>
                <param name="baud_rate">$(arg hw_baud)</param>
                <param name="enc_counts_per_rev">$(arg hw_counts_per_rev)</param>
                <param name="loop_rate">30</param>
                <param name="timeout_ms">1000</param>
                <!-- wheel speed PID inside the motor driver firmware (counts/loop). Tune on the real robot. -->
                <param name="pid_p">20</param>
                <param name="pid_d">12</param>
                <param name="pid_i">0</param>
                <param name="pid_o">50</param>
            </xacro:unless>
        </hardware>
        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-${wheel_max_speed}</param>
                <param name="max">${wheel_max_speed}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-${wheel_max_speed}</param>
                <param name="max">${wheel_max_speed}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

</robot>

      <visual name="door"><pose>0 -3.03 1.1 0 0 0</pose><geometry><box><size>1.4 0.06 2.2</size></box></geometry><material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
      <visual name="blue_sign"><pose>0 -3.05 2.6 0 0 0</pose><geometry><box><size>10 0.08 0.6</size></box></geometry><material><ambient>0.12 0.28 0.75 1</ambient><diffuse>0.12 0.28 0.75 1</diffuse></material></visual>
      </link>
    </model>

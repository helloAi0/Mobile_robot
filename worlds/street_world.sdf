      <visual name="roof"><pose>0 0 5.12 0 0 0</pose><geometry><box><size>10.6 6.6 0.25</size></box></geometry><material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual>
      <visual name="win_0_0"><pose>-4 -3.02 1.9 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_0_1"><pose>-2 -3.02 1.9 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_0_3"><pose>2 -3.02 1.9 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_0_4"><pose>4 -3.02 1.9 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_1_0"><pose>-4 -3.02 3.5999999999999996 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_1_1"><pose>-2 -3.02 3.5999999999999996 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_1_2"><pose>0 -3.02 3.5999999999999996 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>
      <visual name="win_1_3"><pose>2 -3.02 3.5999999999999996 0 0 0</pose><geometry><box><size>0.9 0.05 1.1</size></box></geometry><material><ambient>0.25 0.38 0.55 1</ambient><diffuse>0.25 0.38 0.55 1</diffuse></material></visual>

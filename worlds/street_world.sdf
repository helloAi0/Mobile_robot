<?xml version="1.0" ?>
<!--
  Street world for Gazebo Harmonic (gz-sim 8). Generated layout:
    sidewalk (ground, grey) | grass + trees + 3 buildings on the left | curb + road with crosswalk and cars on the right
    lamp posts, benches, mailbox, trash can, planter, a cardboard box
    people: a man crossing at x=4.5 m, a woman walking along the sidewalk (x 7..15 m, y=2.8 m), a woman standing

  - The robot spawns at the origin facing +x.
  - People are Gazebo "actors": animated meshes without physics. No collision (the robot can drive through
    them) but the camera and the lidar DO see them. They are downloaded from Gazebo Fuel the first time
    (internet needed, can take a minute, cached in ~/.gz/fuel). If a download fails the world still loads.
  - Only the ground, trees, lamps, benches, buildings, cars and small props have collision.
  - The Sensors system below is required, otherwise camera and lidar never render.
-->
<sdf version="1.9">
  <world name="default">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.62 0.78 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Ground = grey sidewalk (the only big collision surface, so the robot sits on it) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grass strip left of the sidewalk (visual only) -->
    <model name="grass">
      <static>true</static>
      <pose>12 9 0.01 0 0 0</pose>
      <link name="link">
      <visual name="v"><pose>0 0 0 0 0 0</pose><geometry><box><size>48 9 0.02</size></box></geometry><material><ambient>0.3 0.55 0.22 1</ambient><diffuse>0.3 0.55 0.22 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Road on the right (visual only) -->
    <model name="road">
      <static>true</static>
      <pose>12 -11 0.005 0 0 0</pose>
      <link name="link">
      <visual name="v"><pose>0 0 0 0 0 0</pose><geometry><box><size>48 10 0.01</size></box></geometry><material><ambient>0.16 0.16 0.18 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Curb between sidewalk and road -->
    <model name="curb">
      <static>true</static>
      <pose>12 -6.1 0.06 0 0 0</pose>
      <link name="link">
      <visual name="v"><pose>0 0 0 0 0 0</pose><geometry><box><size>48 0.3 0.12</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Dashed centre line -->
    <model name="road_centre_line">
      <static>true</static>
      <pose>12 -11 0.012 0 0 0</pose>
      <link name="link">
      <visual name="d0"><pose>-20 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d1"><pose>-16 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d2"><pose>-12 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d3"><pose>-8 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d4"><pose>-4 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d5"><pose>0 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d6"><pose>4 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d7"><pose>8 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d8"><pose>12 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d9"><pose>16 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      <visual name="d10"><pose>20 0 0.0 0 0 0</pose><geometry><box><size>2 0.15 0.012</size></box></geometry><material><ambient>0.95 0.85 0.2 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Zebra crossing -->
    <model name="crosswalk">
      <static>true</static>
      <pose>16 -11 0.012 0 0 0</pose>
      <link name="link">
      <visual name="z0"><pose>0 -3.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z1"><pose>0 -2.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z2"><pose>0 -1.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z3"><pose>0 -0.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z4"><pose>0 0.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z5"><pose>0 1.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z6"><pose>0 2.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="z7"><pose>0 3.5 0 0 0 0</pose><geometry><box><size>3.0 0.5 0.012</size></box></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      </link>
    </model>

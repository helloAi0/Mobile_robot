<?xml version="1.0" ?>
<!--
  Street scene for Gazebo Harmonic (gz-sim 8): sidewalk, grass, road, a building, trees, a mailbox,
  a box, a standing woman and a pedestrian who walks back and forth in front of the robot.

  - The robot spawns at the origin facing +x. The pedestrian crosses at x = 3 m, so she is inside the
    range of the depth camera (8 m) and the lidar (12 m) from the start.
  - People are Gazebo "actors": animated meshes without physics. They have no collision, so the robot
    can drive "through" them, but the camera and the lidar DO see them (they render meshes).
  - The two people are downloaded from Gazebo Fuel the first time the world starts (needs internet,
    can take a minute; cached in ~/.gz/fuel afterwards). If a download fails the world still loads.
  - The Sensors system below is required, otherwise camera and lidar never render.
-->
<sdf version="1.9">
  <world name="default">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.62 0.78 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Ground = grey sidewalk (the only thing with collision, so the robot sits on it) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grass strip on the left of the sidewalk (visual only) -->
    <model name="grass">
      <static>true</static>
      <pose>12 8 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>44 9 0.02</size></box></geometry>
          <material><ambient>0.30 0.55 0.22 1</ambient><diffuse>0.30 0.55 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Road on the right (visual only) -->
    <model name="road">
      <static>true</static>
      <pose>12 -10 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>44 8 0.01</size></box></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building behind the grass -->
    <model name="building">
      <static>true</static>
      <pose>14 17 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 6 5</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>10 6 5</size></box></geometry>
          <material><ambient>0.62 0.70 0.86 1</ambient><diffuse>0.62 0.70 0.86 1</diffuse></material>
        </visual>
        <visual name="blue_trim">
          <pose>0 -3.02 -1.2 0 0 0</pose>
          <geometry><box><size>10 0.06 0.5</size></box></geometry>
          <material><ambient>0.12 0.28 0.75 1</ambient><diffuse>0.12 0.28 0.75 1</diffuse></material>
        </visual>
        <visual name="door">
          <pose>0 -3.02 -0.9 0 0 0</pose>
          <geometry><box><size>1.4 0.06 2.2</size></box></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><box><size>10.6 6.6 0.25</size></box></geometry>
          <material><ambient>0.25 0.25 0.30 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trees (trunk + foliage) -->
    <model name="tree_1">
      <static>true</static>
      <pose>9 5.5 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_col"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry></collision>
        <visual name="trunk">
          <pose>0 0 1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.38 0.25 0.13 1</ambient><diffuse>0.38 0.25 0.13 1</diffuse></material>
        </visual>
        <visual name="leaves">
          <pose>0 0 3 0 0 0</pose>
          <geometry><sphere><radius>1.3</radius></sphere></geometry>
          <material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.15 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>19 6 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_col"><pose>0 0 1.1 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.2</length></cylinder></geometry></collision>
        <visual name="trunk">
          <pose>0 0 1.1 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>2.2</length></cylinder></geometry>
          <material><ambient>0.38 0.25 0.13 1</ambient><diffuse>0.38 0.25 0.13 1</diffuse></material>
        </visual>
        <visual name="leaves">
          <pose>0 0 3.3 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.12 0.40 0.14 1</ambient><diffuse>0.12 0.40 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue mailbox on the road side of the sidewalk -->
    <model name="mailbox">
      <static>true</static>
      <pose>7 -3.8 0 0 0 0</pose>
      <link name="link">
        <collision name="post_col"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>0.45 0.35 1.1</size></box></geometry></collision>
        <visual name="body">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry><box><size>0.45 0.35 1.1</size></box></geometry>
          <material><ambient>0.1 0.25 0.7 1</ambient><diffuse>0.1 0.25 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A cardboard box on the sidewalk -->
    <model name="cardboard_box">
      <static>true</static>
      <pose>6 1.8 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.60 0.45 0.25 1</ambient><diffuse>0.60 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pedestrian: standard Gazebo walking actor (verified syntax from the Gazebo actors tutorial).
         Walks along y at x = 3 m, turns around at both ends, loops forever. -->
    <actor name="pedestrian">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>   <pose>3 -3 1.0 0 0  1.57</pose></waypoint>
          <waypoint><time>6</time>   <pose>3  3 1.0 0 0  1.57</pose></waypoint>
          <waypoint><time>6.5</time> <pose>3  3 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>12.5</time><pose>3 -3 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>13</time>  <pose>3 -3 1.0 0 0  1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- A woman standing on the sidewalk (OpenRobotics "Casual female" model from Fuel).
         Standing, not walking. -->
    <include>
      <name>woman_standing</name>
      <pose>5.5 -2.2 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
    </include>

    <!-- OPTIONAL, untested: a walking woman from Fuel (Luca / FemaleVisitorWalk). Uncomment to try it.
         Its walking path is defined inside the model, so she may not walk in front of the robot.
    <include>
      <uri>https://fuel.gazebosim.org/1.0/Luca/models/FemaleVisitorWalk</uri>
    </include>
    -->

  </world>
</sdf>

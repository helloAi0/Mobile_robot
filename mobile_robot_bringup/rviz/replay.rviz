Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid (1 m)
      Cell Size: 1
      Plane Cell Count: 20
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map (SLAM)
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Global costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.5
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Local costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.5
      Color Scheme: costmap
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Lidar (magenta)
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 0.04
      Alpha: 1
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 255; 0; 255
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 plan
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 25; 255; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Wheel odometry (red)
      Topic:
        Value: /diff_cont/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 400
      Position Tolerance: 0.02
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 40; 40
        Alpha: 0.9
        Shaft Length: 0.15
        Head Length: 0.08
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: EKF fused (green)
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 400
      Position Tolerance: 0.02
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 40; 220; 80
        Alpha: 0.9
        Shaft Length: 0.15
        Head Length: 0.08
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Goal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 200; 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detections
      Topic:
        Value: /detections
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Camera (if recorded)
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      # top-down: reads like a floor plan. Switch to Orbit in the Views panel for a 3D look.
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 55
      X: 0
      Y: 0
      Angle: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Width: 1500

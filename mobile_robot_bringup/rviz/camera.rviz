Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid (1 m squares)
      Cell Size: 1
      Plane Cell Count: 16
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: MAP (built by SLAM)
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 path
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 25; 255; 0
      Line Style: Lines
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Camera 3D (floor removed)
      Topic:
        Value: /camera/points_filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 0.03
      Alpha: 1
      Decay Time: 0
      Color Transformer: RGB8
      Position Transformer: XYZ
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LIDAR (magenta)
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      # The LIDAR: one thin ring of bright magenta dots = where its 720 beams hit something, 360 degrees
      # around the robot, up to 12 m. Gaps in the ring = nothing within 12 m in that direction.
      Style: Flat Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 255; 0; 255
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detections (orange + distance)
      Topic:
        Value: /detections
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera image
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Depth image
      Topic:
        Value: /camera/depth/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      # Fixed 0-8 m range: with auto-normalise, the 'inf' pixels (sky / beyond 8 m) make the image all black.
      Normalize Range: false
      Min Value: 0
      Max Value: 8
    - Class: rviz_default_plugins/Image
      Enabled: false
      # Optional: only has data if you started the real webcam (launch arg webcam:=true)
      Name: Webcam (optional)
      Topic:
        Value: /webcam/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Normalize Range: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  # Toolbar: without this section RViz has no Interact / Move Camera tools and the mouse cannot orbit.
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 9
      Pitch: 1.3
      Yaw: 3.14159
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500

# /etc/default/mobile_robot : extra launch arguments for the real robot (edit, then: sudo systemctl restart mobile_robot)
# hw_plugin = your ros2_control driver, hw_device = its serial port (use the udev symlink from deploy/99-mobile-robot.rules)
HW_ARGS="hw_plugin:=diffdrive_arduino/DiffDriveArduino hw_device:=/dev/robot_motor hw_baud:=57600 hw_counts_per_rev:=3436 slam:=true"
